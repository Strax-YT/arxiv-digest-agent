# ---------------------------------------------------------------------------
# Copy to .env and edit. Every value has a working default; nothing is required
# if you run Ollama locally.
# ---------------------------------------------------------------------------

# ollama | groq | gemini | openrouter | mock
LLM_PROVIDER=ollama

# Leave blank to take the provider default:
#   ollama     -> qwen2.5:7b-instruct
#   groq       -> openai/gpt-oss-120b
#   gemini     -> gemini-2.0-flash
#   openrouter -> meta-llama/llama-3.3-70b-instruct:free
LLM_MODEL=

# Only needed for the hosted providers. All have free tiers.
# GROQ_API_KEY=
# GOOGLE_API_KEY=
# OPENROUTER_API_KEY=

# LLM_BASE_URL=http://localhost:11434
# LLM_TEMPERATURE=0.1
# LLM_MAX_TOKENS=2048

# auto | sentence-transformers | hashing
EMBEDDING_BACKEND=auto
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# auto | chroma | numpy
VECTOR_BACKEND=auto

# CHUNK_CHARS=1200
# CHUNK_OVERLAP=180
# RETRIEVAL_K=8
# RERANK_K=5
# MIN_SIMILARITY=0.15

# MAX_PDF_PAGES=60
# ARXIV_MAX_RESULTS=20

# Where sessions, the vector store and cached PDFs live.
# ARXIV_AGENT_HOME=~/.arxiv_agent
